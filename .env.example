# Optional Microsoft Foundry Responses API connection.
# Leave unset to use evidence-backed templates. Keep real keys in local or
# hosting environment variables; never commit them to Git.
# Full public-Azure HTTPS URL ending /openai/v1/responses; no query string.
FOUNDRY_RESPONSES_URL=
# Use the resource's actual deployed-model name.
FOUNDRY_MODEL=
FOUNDRY_API_KEY=

# Optional deployment context only. The current Foundry adapter uses the API key
# above, not these values. Readiness reports presence only; never prints values.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Fixed-window limits per process; not a global Azure spending cap.
AI_MAX_REQUESTS_PER_PROCESS=200
AI_BUDGET_WINDOW_SECONDS=3600
AI_MAX_CONCURRENT_REQUESTS=2
# Optional frontend build flag; keep disabled until core public release passes.
VITE_ENABLE_TEAM_FOCUS=false
