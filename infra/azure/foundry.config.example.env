# Non-secret deployment configuration. Copy outside Git and fill reviewed values.
AZURE_SUBSCRIPTION_ID=YOUR-SUBSCRIPTION-UUID
AFTER90_RESOURCE_GROUP=after90-demo
# Choose a supported region with actual model/version/SKU quota in your account.
AFTER90_LOCATION=YOUR-CANONICAL-REGION
# Resource/custom subdomain must be globally available and lowercase.
AFTER90_FOUNDRY_RESOURCE=YOUR-UNIQUE-LOWERCASE-NAME
AFTER90_FOUNDRY_DEPLOYMENT=after90-narrator
# Copy exact model name AND version from your region's available model catalog.
# No model is automatically chosen by the setup script.
AFTER90_FOUNDRY_MODEL=YOUR-MODEL-NAME
AFTER90_FOUNDRY_MODEL_VERSION=YOUR-MODEL-VERSION
AFTER90_FOUNDRY_SKU=GlobalStandard
# Model-dependent quota units; not a dollar cap. Review price and quota first.
AFTER90_FOUNDRY_CAPACITY=1
# --apply may create the named resource group only when this is true.
AFTER90_FOUNDRY_CREATE_GROUP=false
# Set true only after permissions, region/model/strict-output support, quota and
# a spending ceiling have been reviewed. --apply is ALSO required to mutate Azure.
AFTER90_FOUNDRY_APPROVED=false
