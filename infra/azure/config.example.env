# Copy values into a private release shell or hosting secret store.
# These placeholders are not deployable credentials or verified resource names.
AZURE_SUBSCRIPTION_ID=
AFTER90_RESOURCE_GROUP=
AFTER90_LOCATION=southindia
AFTER90_ENVIRONMENT_NAME=after90-env
AFTER90_APP_NAME=after90-app
AFTER90_CONTAINER_IMAGE=
AFTER90_MIN_REPLICAS=1
AFTER90_CLOUD_APPROVED=false
# Only for an existing private ACR and pre-authorized pull identity:
AFTER90_REGISTRY_SERVER=
AFTER90_REGISTRY_IDENTITY_ID=
